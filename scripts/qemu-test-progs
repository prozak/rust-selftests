#!/bin/bash
# qemu-test-progs -t <comma-separated-tests> [-d <comma-separated-denylist>]
#
# Test runner of the QEMU flavor (counterpart of uml-veristat's
# uml-test-progs, which serves FLAVOR=uml): run the
# selftests' test_progs with a -t filter inside a QEMU guest booting the
# x86_64 kernel built from the same pinned bpf-next tree. The host
# filesystem is shared into the guest (virtme), so the selftests output
# directory is used in place.
#
# Env:
#   SELFTESTS_OUTPUT  selftests output dir to run in (required)
#   TEST_PROGS        test_progs binary (default: $SELFTESTS_OUTPUT/test_progs)
#   QEMU_KERNEL       bzImage (default from scripts/paths.sh)
#   VNG               vng binary (default: vng on PATH, else
#                     $BUILD_DIR/vng-venv/bin/vng)
#   QEMU_CPUS/QEMU_MEM  guest size (default 8 / 4G)
#   QEMU_TIMEOUT      seconds before the guest is killed (default 600)
#   GATE_UPPER        a gate worker's overlay upper dir (scripts/
#                     gate-overlay.sh): the guest runs in
#                     overlay(GATE_UPPER over SELFTESTS_OUTPUT) mounted on
#                     SELFTESTS_OUTPUT's own path, with its writes on tmpfs
#   TEST_PROGS_EXTRA  extra test_progs arguments (e.g. -v to print the
#                     libbpf and verifier log of passing tests too)
#   QEMU_ALLOW_TCG    set to run without a usable /dev/kvm (slow)
#   GATE_LOOP         a gate worker's dir: boot once and run the jobs the
#                     host posts there, one object after another
#                     (scripts/gate-guest-loop; -t is not used), until
#                     <dir>/stop or QEMU_TIMEOUT (default a day here)

set -uo pipefail

FILTER=""
DENY=""
while getopts "t:d:" opt; do
    case "$opt" in
        t) FILTER="$OPTARG" ;;
        d) DENY="$OPTARG" ;;
        *) echo "usage: $0 -t <tests> [-d <denylist>]" >&2; exit 2 ;;
    esac
done

: "${SELFTESTS_OUTPUT:?}"
OUT="${SELFTESTS_OUTPUT}"
TEST_PROGS="${TEST_PROGS:-${OUT}/test_progs}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "${HERE}/scripts/paths.sh"
VNG="${VNG:-$(command -v vng || echo "${BUILD_DIR}/vng-venv/bin/vng")}"

[ -x "${VNG}" ] || { echo "vng not found at ${VNG}" >&2; exit 1; }
# vng shells out to virtme-run etc. from its own venv — put it on PATH
export PATH="$(dirname "${VNG}"):${PATH}"
[ -f "${QEMU_KERNEL}" ] || { echo "kernel not found: ${QEMU_KERNEL}" >&2; exit 1; }
# Without KVM, QEMU silently falls back to software emulation: the guest is
# several times slower and timing-sensitive tests fail for C and Rust alike.
# Permissions are not enough: with hardware virtualization missing (no
# svm/vmx exposed to a nested VM) the node exists, is group kvm, and opening
# it fails with ENODEV -- and vng then boots under TCG without saying so.
if ! { exec 3<>/dev/kvm; } 2>/dev/null; then
    [ -n "${QEMU_ALLOW_TCG:-}" ] || {
        echo "/dev/kvm cannot be opened by $(id -un) ($(ls -l /dev/kvm 2>&1));" \
             "fix its permissions or set QEMU_ALLOW_TCG=1 to run emulated" >&2
        exit 1
    }
fi
exec 3<&-
[ -x "${TEST_PROGS}" ] || { echo "test_progs not found: ${TEST_PROGS}" >&2; exit 1; }

# One guest for a worker's whole queue: the per-object prelude below moves
# into scripts/gate-guest-loop, run per job. The command is a path, not a
# script: the kernel command line is capped at 2048 bytes (below). The
# loop's own output goes to a file of its own: vng relays the guest
# command's stdout through a descriptor of its own on our stdout's file,
# writing from offset 0, under the kernel console it appends to the same
# file, and a hundred job lines overwrite the boot banner (`Linux
# version`, `Hypervisor detected: KVM`) the TCG check reads.
if [ -n "${GATE_LOOP:-}" ]; then
    exec timeout "${QEMU_TIMEOUT:-86400}" "${VNG}" \
        --run "${QEMU_KERNEL}" \
        --cpus "${QEMU_CPUS:-8}" --memory "${QEMU_MEM:-4G}" \
        --rw \
        --cwd "${OUT}" \
        --verbose \
        -- "${HERE}/scripts/gate-guest-loop '${GATE_LOOP}' '${OUT}' > '${GATE_LOOP}/loop.log' 2>&1"
fi

# vng passes the guest command on the KERNEL COMMAND LINE, which x86 caps at
# 2048 bytes. Objects consumed by a prog_tests file that registers many tests
# (verifier.c registers every verifier_*: ~2.5KB of names) overflow it, and
# the guest panics with "Unable to mount root fs" because the truncation eats
# the boot arguments. test_progs takes the list from a file instead when the
# argument starts with '@' (test_progs.c:parse_test_list_file), and $OUT is
# the shared, writable guest cwd.
# Under GATE_UPPER the file goes into the worker's layer: the shared tree is
# read-only to the gate.
# Always a file: the gate's overlay prelude, vng's init path and the -d
# argument leave only a few hundred bytes of the 2048-byte command line,
# and a 200-char filter still truncated it (timer, timer_interrupt,
# xdp_dummy lost their init path and panicked).
tr ',' '\n' <<< "${FILTER}" > "${GATE_UPPER:-${OUT}}/.test-filter"
TEST_ARG="-t @.test-filter"
# -d is test_progs's glob denylist: whole-name matches (test or
# test/subtest), unlike -t's substring matches, so a denied test stays out
# even when a -t name is a substring of it (stack_arg vs verifier_stack_arg).
# Always a file: subtest names carry spaces and '>' that do not survive the
# kernel command line (the guest panics on a mangled init path).
if [ -n "${DENY}" ]; then
    tr ',' '\n' <<< "${DENY}" > "${GATE_UPPER:-${OUT}}/.test-deny"
    TEST_ARG="${TEST_ARG} -d @.test-deny"
fi

# GATE_UPPER: rebuild the worker's view in the guest before running. 9p
# hides overlay whiteouts (the host lists them as char devices, lookups
# fail), so files the host deleted are deleted again in the guest's layer.
# test_progs itself then runs from a copy on the tmpfs, not from the
# overlay: a file mapped through overlayfs has the real layer file as
# vm_file, so bpf_d_path() on test_progs's own text mapping names the
# layer's path while /proc/<pid>/maps shows the overlay path, and
# prog_tests/bpf_iter.c's task_vma subtest, which compares the two,
# fails for C and Rust alike. From tmpfs both say /run/gate/test_progs.
# The cwd stays $OUT: tests open their .bpf.o files relative to it, and
# the uprobe tests resolve themselves through /proc/self/exe either way.
PRELUDE=""
PROG="$(basename "${TEST_PROGS}")"
RUN_PROGS="./${PROG}"
if [ -n "${GATE_UPPER:-}" ]; then
    PRELUDE="mkdir -p /run/gate && mount -t tmpfs tmpfs /run/gate && \
mkdir /run/gate/u /run/gate/w && \
mount -t overlay overlay -o 'lowerdir=${GATE_UPPER}:${OUT},upperdir=/run/gate/u,workdir=/run/gate/w' '${OUT}' && \
(cd '${GATE_UPPER}' && find . -type c) | while read -r f; do rm -f '${OUT}'/\"\$f\"; done && \
cp -p '${OUT}/${PROG}' /run/gate/ && \
cd '${OUT}' && "
    RUN_PROGS="/run/gate/${PROG}"
fi
# A benchs/ object (scripts/bench-consumers): swap-and-test.sh wrote the
# bench rows to .bench-runs (in the worker's layer under GATE_UPPER) and
# the guest runs scripts/gate-bench-run instead of test_progs.
if [ -s "${GATE_UPPER:-${OUT}}/.bench-runs" ]; then
    RUN_PROGS="${HERE}/scripts/gate-bench-run"
    TEST_ARG=""
fi

# vng: boot the kernel, share host fs, run the command in $OUT, propagate
# the exit status. --verbose keeps kernel oops visible in the log.
exec timeout "${QEMU_TIMEOUT:-600}" "${VNG}" \
    --run "${QEMU_KERNEL}" \
    --cpus "${QEMU_CPUS:-8}" --memory "${QEMU_MEM:-4G}" \
    --rw \
    --cwd "${OUT}" \
    --verbose \
    -- "${PRELUDE}mount -t bpf bpffs /sys/fs/bpf 2>/dev/null; ${RUN_PROGS} ${TEST_PROGS_EXTRA:-} ${TEST_ARG}"
