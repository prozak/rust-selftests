#!/bin/bash
# qemu-test-progs -t <comma-separated-tests>
#
# Test runner of the QEMU flavor (counterpart of uml-veristat's
# uml-test-progs, which serves FLAVOR=uml): run the
# selftests' test_progs with a -t filter inside a QEMU guest booting the
# x86_64 kernel built from the same pinned bpf-next tree. The host
# filesystem is shared into the guest (virtme), so the selftests output
# directory is used in place.
#
# Env:
#   SELFTESTS_OUTPUT  selftests output dir to run in (required)
#   TEST_PROGS        test_progs binary (default: $SELFTESTS_OUTPUT/test_progs)
#   QEMU_KERNEL       bzImage (default from scripts/paths.sh)
#   VNG               vng binary (default: vng on PATH, else
#                     $BUILD_DIR/vng-venv/bin/vng)
#   QEMU_CPUS/QEMU_MEM  guest size (default 8 / 4G)
#   QEMU_TIMEOUT      seconds before the guest is killed (default 600)
#   QEMU_ALLOW_TCG    set to run without a usable /dev/kvm (slow)

set -uo pipefail

FILTER=""
while getopts "t:" opt; do
    case "$opt" in
        t) FILTER="$OPTARG" ;;
        *) echo "usage: $0 -t <tests>" >&2; exit 2 ;;
    esac
done

: "${SELFTESTS_OUTPUT:?}"
OUT="${SELFTESTS_OUTPUT}"
TEST_PROGS="${TEST_PROGS:-${OUT}/test_progs}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "${HERE}/scripts/paths.sh"
VNG="${VNG:-$(command -v vng || echo "${BUILD_DIR}/vng-venv/bin/vng")}"

[ -x "${VNG}" ] || { echo "vng not found at ${VNG}" >&2; exit 1; }
# vng shells out to virtme-run etc. from its own venv — put it on PATH
export PATH="$(dirname "${VNG}"):${PATH}"
[ -f "${QEMU_KERNEL}" ] || { echo "kernel not found: ${QEMU_KERNEL}" >&2; exit 1; }
# Without KVM, QEMU silently falls back to software emulation: the guest is
# several times slower and timing-sensitive tests fail for C and Rust alike.
# Permissions are not enough: with hardware virtualization missing (no
# svm/vmx exposed to a nested VM) the node exists, is group kvm, and opening
# it fails with ENODEV -- and vng then boots under TCG without saying so.
if ! { exec 3<>/dev/kvm; } 2>/dev/null; then
    [ -n "${QEMU_ALLOW_TCG:-}" ] || {
        echo "/dev/kvm cannot be opened by $(id -un) ($(ls -l /dev/kvm 2>&1));" \
             "fix its permissions or set QEMU_ALLOW_TCG=1 to run emulated" >&2
        exit 1
    }
fi
exec 3<&-
[ -x "${TEST_PROGS}" ] || { echo "test_progs not found: ${TEST_PROGS}" >&2; exit 1; }

# vng passes the guest command on the KERNEL COMMAND LINE, which x86 caps at
# 2048 bytes. Objects consumed by a prog_tests file that registers many tests
# (verifier.c registers every verifier_*: ~2.5KB of names) overflow it, and
# the guest panics with "Unable to mount root fs" because the truncation eats
# the boot arguments. test_progs takes the list from a file instead when the
# argument starts with '@' (test_progs.c:parse_test_list_file), and $OUT is
# the shared, writable guest cwd.
TEST_ARG="-t '${FILTER}'"
if [ "${#FILTER}" -gt 512 ]; then
    tr ',' '\n' <<< "${FILTER}" > "${OUT}/.test-filter"
    TEST_ARG="-t @.test-filter"
    echo "[qemu] filter is ${#FILTER} chars — passed via ${OUT}/.test-filter" >&2
fi

# vng: boot the kernel, share host fs, run the command in $OUT, propagate
# the exit status. --verbose keeps kernel oops visible in the log.
exec timeout "${QEMU_TIMEOUT:-600}" "${VNG}" \
    --run "${QEMU_KERNEL}" \
    --cpus "${QEMU_CPUS:-8}" --memory "${QEMU_MEM:-4G}" \
    --rw \
    --cwd "${OUT}" \
    --verbose \
    -- "mount -t bpf bpffs /sys/fs/bpf 2>/dev/null; ./$(basename "${TEST_PROGS}") ${TEST_ARG}"
