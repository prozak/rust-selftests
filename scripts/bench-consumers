xdp_lb_bench xdp-lb --scenario udp-v4-lru-hit
xdp_lb_bench xdp-lb --scenario udp-v6-lru-hit
xdp_lb_bench xdp-lb --scenario tcp-v4v6-lru-hit
xdp_lb_bench xdp-lb --scenario tcp-v4-lru-diverse
xdp_lb_bench xdp-lb --scenario tcp-v4-ch-diverse
xdp_lb_bench xdp-lb --scenario tcp-v6-lru-diverse
xdp_lb_bench xdp-lb --scenario tcp-v6-ch-diverse
xdp_lb_bench xdp-lb --scenario udp-v4-lru-diverse
xdp_lb_bench xdp-lb --scenario tcp-v4-lru-miss
xdp_lb_bench xdp-lb --scenario udp-v4-lru-miss
xdp_lb_bench xdp-lb --scenario tcp-v4-lru-warmup
xdp_lb_bench xdp-lb --scenario tcp-v4-syn
xdp_lb_bench xdp-lb --scenario tcp-v4-rst-miss
xdp_lb_bench xdp-lb --scenario pass-v4-no-vip
xdp_lb_bench xdp-lb --scenario pass-v6-no-vip
